# Set APP_ENV=production to disable development identity headers.
APP_ENV=development
DATABASE_URL=sqlite:///./data/ueaa.db
ARTIFACT_DIR=./artifacts
SESSION_TOKEN_SECRET=replace-with-a-long-random-secret
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
EXTERNAL_OIDC_ISSUER_URL=
EXTERNAL_OIDC_CLIENT_ID=
EXTERNAL_OIDC_CLIENT_SECRET=
EXTERNAL_OIDC_REDIRECT_URI=http://localhost:8000/auth/external/callback
